{
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node --env-file=.env dist/server.js",
        "migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -j ts",
        "migrate:test": "node --env-file=.env.test ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -j ts",
        "test": "vitest run --exclude \"test/**/integration/**\"",
        "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run integration",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run build && npm run lint && npm run format:check"
    },
    "dependencies": {
        "@fastify/postgres": "^6.1.0",
        "fastify": "^5.10.0",
        "fastify-plugin": "^6.0.0",
        "pg": "^8.22.0",
        "typebox": "^1.3.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "node-pg-migrate": "^9.0.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "fsevents": false
    }
}
